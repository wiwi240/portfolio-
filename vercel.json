{
  "regions": [
    "fra1"
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'sha256-prBAMQ7RtoxX/UXxkk3oySuHYW2/NyRR5Jp9QF2lWuQ=' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; font-src 'self'; img-src 'self' data: blob: https://cdn.simpleicons.org; media-src 'self' blob: data:; worker-src 'self' blob:; connect-src 'self' https://accounts.google.com; frame-src https://accounts.google.com; object-src 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/rendez-vous",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    }
  ],
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/expertises",
      "destination": "/a-propos#expertises",
      "statusCode": 301
    },
    {
      "source": "/en/expertise",
      "destination": "/en/about#expertises",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/admin",
      "destination": "/app.html"
    },
    {
      "source": "/rendez-vous",
      "destination": "/app.html"
    },
    {
      "source": "/configurateur",
      "destination": "/app.html"
    },
    {
      "source": "/en/project-configurator",
      "destination": "/app.html"
    },
    {
      "source": "/projets",
      "destination": "/projets.html"
    },
    {
      "source": "/a-propos",
      "destination": "/a-propos.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/faq",
      "destination": "/faq.html"
    },
    {
      "source": "/mentions-legales",
      "destination": "/mentions-legales.html"
    },
    {
      "source": "/cgu",
      "destination": "/cgu.html"
    },
    {
      "source": "/politique-de-confidentialite",
      "destination": "/politique-de-confidentialite.html"
    },
    {
      "source": "/cookies",
      "destination": "/cookies.html"
    },
    {
      "source": "/en/projects",
      "destination": "/en/projects.html"
    },
    {
      "source": "/en/about",
      "destination": "/en/about.html"
    },
    {
      "source": "/en/contact",
      "destination": "/en/contact.html"
    },
    {
      "source": "/en/faq",
      "destination": "/en/faq.html"
    },
    {
      "source": "/en/legal-notice",
      "destination": "/en/legal-notice.html"
    },
    {
      "source": "/en/terms-of-use",
      "destination": "/en/terms-of-use.html"
    },
    {
      "source": "/en/privacy-policy",
      "destination": "/en/privacy-policy.html"
    },
    {
      "source": "/en/cookies",
      "destination": "/en/cookies.html"
    },
    {
      "source": "/en",
      "destination": "/en/index.html"
    },
    {
      "source": "/en/",
      "destination": "/en/index.html"
    }
  ]
}
