{
  "regions": [
    "fra1"
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'sha256-prBAMQ7RtoxX/UXxkk3oySuHYW2/NyRR5Jp9QF2lWuQ=' https://accounts.google.com/gsi/client; script-src-attr 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://api.fontshare.com https://accounts.google.com/gsi/style; font-src 'self' https://fonts.gstatic.com https://cdn.fontshare.com; img-src 'self' data: blob: https://cdn.simpleicons.org; media-src 'self' blob: data:; worker-src 'self' blob:; connect-src 'self' https://accounts.google.com; frame-src https://accounts.google.com; object-src 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/rendez-vous",
      "destination": "/index.html"
    },
    {
      "source": "/projets",
      "destination": "/index.html"
    },
    {
      "source": "/expertises",
      "destination": "/index.html"
    },
    {
      "source": "/a-propos",
      "destination": "/index.html"
    },
    {
      "source": "/contact",
      "destination": "/index.html"
    },
    {
      "source": "/configurateur",
      "destination": "/index.html"
    },
    {
      "source": "/faq",
      "destination": "/index.html"
    },
    {
      "source": "/mentions-legales",
      "destination": "/index.html"
    },
    {
      "source": "/cgu",
      "destination": "/index.html"
    },
    {
      "source": "/politique-de-confidentialite",
      "destination": "/index.html"
    },
    {
      "source": "/cookies",
      "destination": "/index.html"
    },
    {
      "source": "/en",
      "destination": "/index.html"
    },
    {
      "source": "/en/",
      "destination": "/index.html"
    },
    {
      "source": "/en/projects",
      "destination": "/index.html"
    },
    {
      "source": "/en/expertise",
      "destination": "/index.html"
    },
    {
      "source": "/en/about",
      "destination": "/index.html"
    },
    {
      "source": "/en/contact",
      "destination": "/index.html"
    },
    {
      "source": "/en/project-configurator",
      "destination": "/index.html"
    },
    {
      "source": "/en/faq",
      "destination": "/index.html"
    },
    {
      "source": "/en/legal-notice",
      "destination": "/index.html"
    },
    {
      "source": "/en/terms-of-use",
      "destination": "/index.html"
    },
    {
      "source": "/en/privacy-policy",
      "destination": "/index.html"
    },
    {
      "source": "/en/cookies",
      "destination": "/index.html"
    }
  ]
}
